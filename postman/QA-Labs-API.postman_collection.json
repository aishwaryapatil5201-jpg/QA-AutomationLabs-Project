      "name": "4. Auth",
      "item": [
        {
          "name": "Login (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns a JWT', () => {",
                  "  const token = pm.response.json().data.accessToken;",
                  "  pm.expect(token).to.match(/^eyJ/);",
                  "  pm.expect(token.split('.')).to.have.lengthOf(3);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
