      "name": "1. Health",
      "item": [
        {
          "name": "Get status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('service is operational', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.status).to.eql('operational');",
                  "  pm.expect(body.data.version).to.be.a('string');",
                  "});",
                  "pm.test('response has a requestId', () => {",
                  "  pm.expect(pm.response.json().meta.requestId).to.match(/^req_/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["status"]
            }
          }
        },
        {
          "name": "Get stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has data', () => pm.expect(pm.response.json().data).to.be.an('object'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stats",
              "host": ["{{baseUrl}}"],
              "path": ["stats"]
            }
          }
        }
      ]
