        {
          "name": "List products (paginated)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns an array', () => {",
                  "  pm.expect(pm.response.json().data).to.be.an('array');",
                  "});",
                  "pm.test('respects the limit', () => {",
                  "  pm.expect(pm.response.json().data.length).to.be.at.most(5);",
                  "});",
                  "pm.test('pagination is consistent', () => {",
                  "  const p = pm.response.json().pagination;",
                  "  pm.expect(p.totalPages).to.eql(Math.ceil(p.totalItems / p.pageSize));",
                  "});",
                  "pm.test('first product has the expected shape', () => {",
                  "  const p = pm.response.json().data[0];",
                  "  pm.expect(p).to.have.all.keys('id','name','sku','category','price','currency','stock','status','createdAt','rating');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?page=1&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "5" }
              ]
            }
